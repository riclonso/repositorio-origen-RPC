generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Catálogo de perfiles. Reemplaza al enum `Rol`: los perfiles son datos, no código, para que
// agregar uno nuevo no exija una migración ni un despliegue.
model Perfil {
  codigo      String   @id @db.VarChar(40)
  nombre      String   @unique
  descripcion String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relación inversa exigida por Prisma. NUNCA usarla con `include` en el listado de usuarios:
  // cargaría los usuarios de cada perfil (N+1).
  usuarios Usuario[]

  @@map("perfil")
}

model Usuario {
  id             String   @id @default(uuid())
  nombres        String
  apellidos      String
  rut            String   @unique
  email          String   @unique
  username       String   @unique
  // NULL = cuenta pendiente de activación: se creó sin contraseña y no puede iniciar sesión
  // hasta fijarla con un enlace de un solo uso. No-nulo = cuenta con contraseña. Esta columna
  // es la autoridad ÚNICA del estado "pendiente" (sin flag paralelo que pueda desincronizarse).
  contrasenaHash String?
  perfilCodigo   String   @db.VarChar(40)
  perfil         Perfil   @relation(fields: [perfilCodigo], references: [codigo], onUpdate: Cascade, onDelete: Restrict)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())

  // RF-30: establecimiento al que pertenece la persona. Nullable a propósito: solo es obligatorio
  // para el perfil NOTIFICADOR_RPC (regla en `application/` y en el esquema Zod, no en la BD), y
  // las cuentas previas a RF-30 no lo tienen. `Restrict`: un establecimiento con usuarios no puede
  // borrarse físicamente (hoy solo se desactiva; los usuarios lo conservan).
  establecimientoId String?
  establecimiento   Establecimiento? @relation(fields: [establecimientoId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  // Invalidación de sesión: se incrementa cada vez que cambia `contrasenaHash` (fijado manual por
  // el admin, autoservicio propio, o consumo de un enlace de contraseña), en las tres transacciones
  // que escriben el hash. El JWT emitido en el login lleva un claim `sesionVersion` con el valor
  // vigente al emitir; `verificarSesion()` lo compara contra esta columna y devuelve `null` si no
  // coincide, cerrando cualquier sesión abierta con la contraseña anterior. Desplegar esta columna
  // invalida además, una única vez, TODAS las sesiones activas del sistema: todo JWT emitido antes
  // de este cambio no trae el claim `sesionVersion` nuevo, mismo efecto colateral ya asumido con el
  // renombre del claim `rol`→`perfil` en `JwtService.ts` (RF-09).
  sesionVersion    Int       @default(0)
  // Bloqueo progresivo por intentos fallidos de login (ver `DURACIONES_BLOQUEO_MINUTOS` en
  // `modules/auth/domain/entities/User.ts`). `intentosFallidos` son los fallos CONSECUTIVOS del
  // ciclo actual: se resetea a 0 en un login exitoso y también al activarse un bloqueo (arranca un
  // ciclo nuevo). `vecesBloqueada` es monotónico de por vida (nunca se resetea, ni con login
  // exitoso ni con un desbloqueo manual del administrador): determina la duración del PRÓXIMO
  // bloqueo. `bloqueadaHasta` nulo = sin bloqueo vigente.
  intentosFallidos Int       @default(0)
  bloqueadaHasta   DateTime? @db.Timestamp(3)
  vecesBloqueada   Int       @default(0)

  // Relación inversa exigida por Prisma. NUNCA usarla con `include`: el listado de usuarios
  // arrastraría los tokens de cada fila (mismo motivo ya anotado en Perfil.usuarios).
  tokensRecuperacion TokenRecuperacion[]

  // Relación inversa exigida por Prisma. NUNCA usarla con `include` en el listado de usuarios,
  // mismo motivo que `tokensRecuperacion`: el detalle (`obtenerPorId`) sí la trae con un JOIN
  // acotado a esa única fila.
  formatosAsignados UsuarioFormatoExcel[]

  // Relaciones inversas de RF-14, exigidas por Prisma. NUNCA usarlas con `include` en el listado
  // de usuarios, mismo motivo que `tokensRecuperacion`/`formatosAsignados`: arrastrarían el
  // historial completo de cargas de cada fila.
  cargasArchivo       CargaArchivo[] @relation("CargasSubidasPorUsuario")
  cargasVistoBuenoPor CargaArchivo[] @relation("CargasConVistoBuenoDe")

  // Relaciones inversas de la publicación de cargas aprobadas hacia el revisor y de las
  // solicitudes de reemplazo, exigidas por Prisma. NUNCA usarlas con `include` en el listado de
  // usuarios, mismo motivo que `cargasArchivo`: arrastrarían el historial completo de cada fila.
  publicacionesCargaCreadas       CargaArchivoPublicada[]   @relation("PublicacionesCargaCreadasPor")
  solicitudesReemplazoSolicitadas SolicitudReemplazoCarga[] @relation("SolicitudesReemplazoSolicitadasPor")
  solicitudesReemplazoRevisadas   SolicitudReemplazoCarga[] @relation("SolicitudesReemplazoRevisadasPor")
  // Relación inversa del rechazo unilateral de cargas aprobadas, exigida por Prisma. NUNCA usarla
  // con `include` en el listado de usuarios, mismo motivo que `cargasArchivo`.
  cargasRechazadas                CargaArchivoRechazo[]     @relation("RechazosDecididosPor")

  // Relación inversa de RF-15, exigida por Prisma. NUNCA usarla con `include` en el listado de
  // usuarios, mismo motivo que `cargasArchivo`: arrastraría el historial completo de ventanas
  // creadas por cada fila.
  ventanasCargaCreadas    VentanaCarga[] @relation("VentanasCargaCreadasPor")
  // Relación inversa de la eliminación de ventanas (RF-15), exigida por Prisma. Mismo motivo que
  // `ventanasCargaCreadas`: nunca usarla con `include` en el listado.
  ventanasCargaEliminadas VentanaCarga[] @relation("VentanasCargaEliminadasPor")

  // Relaciones inversas de las alertas por email a notificadores, exigidas por Prisma. NUNCA
  // usarlas con `include` en el listado de usuarios, mismo motivo que `cargasArchivo`: arrastrarían
  // el historial completo de alertas de cada fila.
  alertasRecibidas  AlertaNotificacionVentana[] @relation("AlertasNotificacionRecibidasPor")
  alertasDisparadas AlertaNotificacionVentana[] @relation("AlertasNotificacionDisparadasPor")

  // Relaciones inversas de RF-31 (mensajería sobre cargas), exigidas por Prisma. NUNCA usarlas con
  // `include` en el listado de usuarios, mismo motivo que `cargasArchivo`: arrastrarían todo el
  // historial de mensajes de cada fila.
  mensajesCargaEscritos  MensajeCarga[] @relation("MensajesCargaEscritosPor")
  mensajesCargaRecibidos MensajeCarga[] @relation("MensajesCargaDeNotificador")

  // Relaciones inversas de RF-37 (perfil Bioestadística), exigidas por Prisma. NUNCA usarlas con
  // `include` en el listado de usuarios, mismo motivo que `cargasArchivo`: arrastrarían el historial
  // completo de archivos y solicitudes de cada fila.
  cargasBioestadistica                          CargaBioestadistica[]              @relation("CargasBioestadisticaSubidasPor")
  solicitudesReemplazoBioestadisticaSolicitadas SolicitudReemplazoBioestadistica[] @relation("SolicitudesReemplazoBioestadisticaSolicitadasPor")
  solicitudesReemplazoBioestadisticaRevisadas   SolicitudReemplazoBioestadistica[] @relation("SolicitudesReemplazoBioestadisticaRevisadasPor")

  // Política de eliminación FÍSICA (RF-25): una cuenta solo puede borrarse si no tiene historial.
  //  - Las 15 relaciones con `onDelete: Restrict` (cargas, vistos buenos, publicaciones,
  //    solicitudes de reemplazo solicitadas/revisadas, rechazos, ventanas creadas/eliminadas,
  //    alertas recibidas/disparadas, mensajes de carga escritos/recibidos y, desde RF-37, cargas de
  //    Bioestadística y sus solicitudes de reemplazo solicitadas/revisadas) SON historial: una sola
  //    fila impide eliminar, y la FK Restrict es la defensa final de la base.
  //  - Las 2 con `onDelete: Cascade` (`tokensRecuperacion`, `formatosAsignados`) son descartables y
  //    caen con la cuenta.
  // La clasificación vive en `modules/usuarios/infrastructure/repositories/
  // relacionesHistorialUsuario.ts` (fuente única). Una relación nueva hacia `Usuario` DEBE
  // clasificarse ahí: `tests/relaciones-usuario.guard.unit.ts` falla si no.
  // Las relaciones de IDA (con `fields:`, como `perfil` o `establecimiento` de RF-30) NO se
  // clasifican: es `usuario` quien apunta a otra tabla, y borrar la cuenta no las toca.

  @@index([establecimientoId])
  @@map("usuario")
}

// Tipos fijos (todos menos `ENUMERADO`): agregar uno nuevo es una decisión de producto que exige
// código nuevo (un parser propio), así que vive en el enum y no en una tabla de catálogo. `RUT`
// dejó de ser un tipo de dato: el RUT se valida con la regla `RUT_VALIDO`, que admite el RUT
// completo en una columna o repartido en número + dígito verificador. `FECHA_HORA` también se
// quitó: solo se valida la fecha.
// `ENUMERADO` es la excepción configurable: la lista de valores permitidos la define quien
// configura el formato en `TipoEnumeradoFormatoExcel` (propio de cada formato, no un catálogo
// global), y la columna lo referencia por nombre en `ColumnaFormatoExcel.tipoEnumeradoNombre`.
enum TipoDatoColumna {
  TEXTO
  ENTERO
  DECIMAL
  BOOLEANO
  FECHA
  EMAIL
  ENUMERADO
}

// RF-15 (ampliación): tipo de archivo que un `FormatoExcel`/`VentanaCarga` acepta. Dos valores
// fijos, no configurables: agregar un tercero exigiría un lector nuevo en
// `modules/reporte-excel/infrastructure/lectura-archivo/`, así que vive en el enum, mismo
// criterio que `TipoDatoColumna`.
enum TipoArchivo {
  EXCEL
  CSV
}

// Separador de campos de un formato CSV. Lista fija (decisión explícita): agregar uno nuevo exige
// declarar su carácter en `CARACTER_SEPARADOR_CSV` (`domain/entities/FormatoExcel.ts`).
enum SeparadorCsv {
  COMA
  PUNTO_Y_COMA
  TABULADOR
  BARRA_VERTICAL
}

// Especifica la cantidad de columnas, sus nombres y cuáles son obligatorias para un archivo que
// un NOTIFICADOR_RPC deberá subir. La plantilla original se conserva como binario para que el
// administrador pueda descargarla y para dejar registro exacto de lo que se leyó.
model FormatoExcel {
  id                     String      @id @default(uuid())
  nombre                 String      @unique
  descripcion            String?
  nombreArchivoPlantilla String
  tipoContenidoPlantilla String
  // Derivado del `tipoContenidoPlantilla` real detectado al crear (RF-15 ampliación), NUNCA
  // recibido del cliente. Inmutable: no forma parte de `DatosEdicionFormatoExcel`.
  tipoArchivo            TipoArchivo
  // NULL si y solo si `tipoArchivo = EXCEL` (CHECK en la migración). A diferencia de
  // `tipoArchivo`, sí es editable.
  separadorCsv           SeparadorCsv?
  contenidoPlantilla     Bytes
  activo                 Boolean     @default(true)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  columnas          ColumnaFormatoExcel[]
  usuariosAsignados UsuarioFormatoExcel[]
  reglasValidacion  ReglaValidacionFormatoExcel[]
  // Tipos enumerados propios del formato. Solo en la lectura de detalle, NUNCA en `listar()`.
  tiposEnumerados   TipoEnumeradoFormatoExcel[]
  // Relación inversa de RF-14, exigida por Prisma. NUNCA usarla con `include` en `listar()`:
  // mismo motivo que `usuariosAsignados`.
  cargasArchivo     CargaArchivo[]
  // Relación inversa de la corrección que reemplaza `VentanaCarga.tipoArchivo` por una referencia
  // directa a un formato concreto, exigida por Prisma. NUNCA usarla con `include` en `listar()`:
  // mismo motivo que `cargasArchivo`/`usuariosAsignados`.
  ventanasCarga     VentanaCarga[]

  @@map("formato_excel")
}

model ColumnaFormatoExcel {
  id             String          @id @default(uuid())
  formatoExcelId String
  formatoExcel   FormatoExcel    @relation(fields: [formatoExcelId], references: [id], onDelete: Cascade)
  // Posición detectada en la plantilla (1-based). La fija el servidor a partir del orden del
  // arreglo recibido; nunca se confía en un valor de orden enviado por el cliente.
  orden          Int
  // Encabezado tal como se leyó de la primera fila de la plantilla.
  nombre         String
  requerida      Boolean         @default(false)
  tipoDato       TipoDatoColumna
  // Nombre de un `TipoEnumeradoFormatoExcel` del MISMO formato. Por nombre y no por FK, mismo
  // motivo que `ReglaValidacionFormatoExcel.columnas`: `actualizar()` regenera los ids de los
  // hijos en cada edición. No nulo si y solo si `tipoDato = ENUMERADO` (CHECK en la migración).
  tipoEnumeradoNombre String?

  @@unique([formatoExcelId, orden])
  @@unique([formatoExcelId, nombre])
  @@map("columna_formato_excel")
}

// Tipo de dato enumerado definido por quien configura el formato (ADMIN o REVISOR_REPOSITORIO):
// un nombre y la lista de valores permitidos. Propio de cada formato, no un catálogo global. Se
// reemplaza completo al editar (`deleteMany` + `create`), igual que columnas y reglas.
model TipoEnumeradoFormatoExcel {
  id             String       @id @default(uuid())
  formatoExcelId String
  formatoExcel   FormatoExcel @relation(fields: [formatoExcelId], references: [id], onDelete: Cascade)
  // Posición fijada por el servidor a partir del arreglo recibido.
  orden          Int
  nombre         String
  // Valores tal como los escribió el usuario (con trim y NFC). La comparación contra la celda
  // ignora mayúsculas y distingue acentos (`normalizarValorEnumerado`).
  valores        String[]

  @@unique([formatoExcelId, orden])
  @@unique([formatoExcelId, nombre])
  @@map("tipo_enumerado_formato_excel")
}

// Un solo tipo por ahora: de un conjunto de columnas, al menos una debe traer valor; si todas
// vienen vacías en el registro, se rechaza. Agregar un tipo nuevo exige código nuevo (el
// evaluador que las ejecuta contra un archivo real, todavía sin construir), así que vive en el
// enum, mismo criterio que `TipoDatoColumna`.
// RF-15 agrega `FECHA_DENTRO_DE_VENTANA_VIGENTE`: exige que la fecha de una columna del archivo
// caiga dentro del rango de la ventana de carga elegida por el notificador para esa subida.
// Ampliación posterior agrega `FECHA_EFECTIVA_DENTRO_DEL_ANIO_VENTANA`: a diferencia de la
// anterior (rango exacto apertura/vencimiento sobre UNA columna), esta calcula una "fecha
// efectiva" a partir de VARIAS columnas (una principal + al menos una alternativa, convención en
// `columnas[]` documentada en `domain/entities/FormatoExcel.ts`) y la compara solo contra el AÑO
// CALENDARIO de la ventana (`VentanaCarga.anio`), no contra su rango exacto de fechas.
enum TipoReglaValidacionFormatoExcel {
  ALGUNA_COLUMNA_CON_VALOR
  FECHA_EFECTIVA_DENTRO_DEL_ANIO_VENTANA
  FILA_DUPLICADA
  RUT_VALIDO
  CONTENIDO_HTML
  FILA_VACIA
}

// Las columnas de la regla se referencian por NOMBRE (`String[]`), no por FK al id de
// `ColumnaFormatoExcel`: `actualizar()` regenera los ids de las columnas en cada edición
// (`deleteMany` + `create`), así que una FK dura dejaría las reglas huérfanas en el primer
// guardado posterior a su creación. La referencia se revalida en `application/` cada vez que se
// guarda el formato completo.
model ReglaValidacionFormatoExcel {
  id             String                          @id @default(uuid())
  formatoExcelId String
  formatoExcel   FormatoExcel                    @relation(fields: [formatoExcelId], references: [id], onDelete: Cascade)
  // Posición fijada por el servidor a partir del arreglo recibido, igual que en
  // `ColumnaFormatoExcel.orden`.
  orden          Int
  tipo           TipoReglaValidacionFormatoExcel
  columnas       String[]
  mensaje        String

  @@unique([formatoExcelId, orden])
  @@map("regla_validacion_formato_excel")
}

// Asociación N:M explícita entre `Usuario` y `FormatoExcel`, con id propio: mismo patrón que
// `TokenRecuperacion`, este proyecto evita el m2m implícito de Prisma. Un NOTIFICADOR_RPC puede
// tener asignados varios formatos.
//
// La regla "todo NOTIFICADOR_RPC tiene al menos un formato asignado" NO es expresable como un
// CHECK de esta tabla (haría falta un trigger, que el proyecto evita): queda enforced solo en
// `application/`, igual que las reglas anti-autobloqueo de RF-06.
model UsuarioFormatoExcel {
  id             String       @id @default(uuid())
  usuarioId      String
  usuario        Usuario      @relation(fields: [usuarioId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  formatoExcelId String
  // `Restrict` y no `Cascade`: protege contra el borrado físico de un formato con usuarios
  // asignados (la eliminación de formatos quita antes las asignaciones de forma explícita). Del
  // lado del usuario es `Cascade`: al eliminar físicamente una cuenta sin historial (RF-25) sus
  // asignaciones caen con ella, y sus ids quedan en la auditoría como `formatosQuitados`.
  formatoExcel   FormatoExcel @relation(fields: [formatoExcelId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@unique([usuarioId, formatoExcelId])
  @@map("usuario_formato_excel")
}

// Catálogo de tipos de establecimiento. Igual que `Perfil`, es un catálogo de datos: agregar un
// tipo nuevo no exige migración ni despliegue. `activo` gobierna la ASIGNABILIDAD (sale del
// selector para nuevos establecimientos), no la autorización; desactivar un tipo no toca los
// establecimientos que ya lo usan.
model TipoEstablecimiento {
  id                String   @id @default(uuid())
  // Dato visible: conserva mayúsculas y tildes tal como los escribió el operador.
  nombre            String
  // Clave de unicidad DERIVADA de `nombre` (sin tildes, minúsculas, espacios colapsados). La
  // constraint @unique vive aquí y no en `nombre` para que "Clínica" y "clinica" no coexistan.
  nombreNormalizado String   @unique
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())

  // Relación inversa exigida por Prisma. NUNCA usarla con `include` en el listado de
  // establecimientos: cargaría los establecimientos de cada tipo (N+1). El nombre del tipo se
  // trae con un JOIN explícito en la consulta del listado.
  establecimientos Establecimiento[]

  @@map("tipo_establecimiento")
}

// Establecimiento de salud que reporta al RPC. El RUT (de empresa) es el único identificador
// único: dos establecimientos pueden compartir nombre. El tipo viaja por clave foránea.
model Establecimiento {
  id        String              @id @default(uuid())
  rut       String              @unique
  nombre    String
  direccion String
  tipoId    String
  // RF-29: el DELETE de un tipo es válido solo si ningún establecimiento (activo o inactivo) lo
  // usa. La FK `Restrict` es la defensa final: corta el DELETE de un tipo en uso (P2003), que el
  // repositorio traduce a `TipoEstablecimientoEnUsoError`; ese tipo solo puede desactivarse.
  tipo      TipoEstablecimiento @relation(fields: [tipoId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  activo    Boolean             @default(true)
  createdAt DateTime            @default(now())

  // Relación inversa de RF-30, exigida por Prisma. NUNCA usarla con `include` en el listado de
  // establecimientos: cargaría los usuarios de cada fila (N+1). Mismo motivo que `Perfil.usuarios`.
  usuarios Usuario[]

  // Relación inversa de RF-37, exigida por Prisma. NUNCA usarla con `include` en el listado de
  // establecimientos: cargaría los archivos de Bioestadística de cada fila (N+1).
  cargasBioestadistica CargaBioestadistica[]

  @@map("establecimiento")
}

// Catálogo de regiones de Chile (RF-26). La migración que crea la tabla siembra las 16 regiones
// oficiales; el mantenedor permite corregirlas o agregar nuevas sin desplegar. No tiene `activo`:
// la baja es una eliminación física.
model Region {
  id                String   @id @default(uuid())
  // Dato visible: conserva mayúsculas y tildes tal como los escribió el operador.
  nombre            String
  // Clave de unicidad DERIVADA de `nombre` (sin tildes, minúsculas, espacios colapsados), igual
  // que en `TipoEstablecimiento`: "Biobío" y "biobio" no coexisten.
  nombreNormalizado String   @unique
  // Código de dos dígitos con cero a la izquierda ("01".."16"). CHAR(2) por decisión explícita.
  codigo            String   @unique @db.Char(2)
  // Número de la región (1..99). El rango lo refuerza un CHECK agregado a mano en la migración.
  numero            Int      @unique
  createdAt         DateTime @default(now())

  // Relación inversa (RF-27). Solo existe para que Prisma declare la FK de `Provincia`: NO usarla
  // con `include` en listados de regiones (arrastraría todas las provincias por fila). Para saber
  // si una región tiene provincias se consulta `provincia` directamente (`tieneProvincias`).
  provincias Provincia[]

  @@map("region")
}

// Catálogo de provincias de Chile (RF-27). Cada provincia pertenece a una región. La migración
// que crea la tabla siembra las 3 provincias de la región del Biobío (08). Sin `activo`: la baja
// es una eliminación física.
model Provincia {
  id                String   @id @default(uuid())
  // Dato visible: conserva mayúsculas y tildes tal como los escribió el operador.
  nombre            String
  // Clave de unicidad DERIVADA de `nombre` (`normalizarNombre()`), única POR REGIÓN: dos regiones
  // pueden tener provincias homónimas.
  nombreNormalizado String
  // Código INE de tres dígitos ("081"); los dos primeros son el código de la región (lo exige el
  // caso de uso). Único global. El formato lo refuerza un CHECK agregado a mano en la migración.
  codigo            String   @unique @db.Char(3)
  // ON DELETE RESTRICT: una región con provincias no puede eliminarse (P2003 → RegionEnUsoError).
  regionId          String
  region            Region   @relation(fields: [regionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt         DateTime @default(now())

  // Relación inversa (RF-28). Solo existe para que Prisma declare la FK de `Comuna`: NO usarla
  // con `include` en listados de provincias (arrastraría todas las comunas por fila). Para saber
  // si una provincia tiene comunas se consulta `comuna` directamente (`tieneComunas`).
  comunas Comuna[]

  // Además de la unicidad del nombre por región, su primera columna indexa la FK y el filtro por
  // región del listado: no hace falta un índice aparte sobre `regionId`.
  @@unique([regionId, nombreNormalizado])
  @@map("provincia")
}

// Catálogo de comunas de Chile (RF-28). Cada comuna pertenece a una provincia; la región se deriva
// de la provincia (no se guarda `regionId`). La migración que crea la tabla siembra las 12 comunas
// de la provincia de Concepción (081). Sin `activo`: la baja es una eliminación física.
model Comuna {
  id                String    @id @default(uuid())
  // Dato visible: conserva mayúsculas y tildes tal como los escribió el operador.
  nombre            String
  // Clave de unicidad DERIVADA de `nombre` (`normalizarNombre()`), única POR PROVINCIA: dos
  // provincias pueden tener comunas homónimas.
  nombreNormalizado String
  // Código INE de cinco dígitos ("08101"); los tres primeros son el código de la provincia (lo
  // exige el caso de uso). Único global. El formato lo refuerza un CHECK agregado a mano en la
  // migración.
  codigo            String    @unique @db.Char(5)
  // ON DELETE RESTRICT: una provincia con comunas no puede eliminarse (P2003 → ProvinciaEnUsoError).
  provinciaId       String
  provincia         Provincia @relation(fields: [provinciaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt         DateTime  @default(now())

  // Además de la unicidad del nombre por provincia, su primera columna indexa la FK y el filtro por
  // provincia del listado: no hace falta un índice aparte sobre `provinciaId`.
  @@unique([provinciaId, nombreNormalizado])
  @@map("comuna")
}

// Tokens de recuperación de contraseña (RF-10). En la base vive únicamente el SHA-256
// hexadecimal del token: el valor en claro existe solo en memoria durante la petición que lo
// emite y dentro del correo enviado.
model TokenRecuperacion {
  id           String    @id @default(uuid())
  usuarioId    String
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  tokenHash    String    @unique @db.VarChar(64)
  // Quién disparó la emisión: AUTOSERVICIO (formulario público "¿olvidó su contraseña?") o
  // ADMIN (creación / restablecimiento / reenvío desde el mantenedor). El cupo por cuenta solo
  // acota el camino AUTOSERVICIO, así que el conteo del cupo filtra por este valor; el camino
  // ADMIN es una acción autenticada y no lleva cupo. El detalle fino del disparador admin
  // (CREACION/REESTABLECIMIENTO/REENVIO) vive en `logs/auditoria.txt`, no aquí.
  origen       String    @default("AUTOSERVICIO") @db.VarChar(20)
  // Las cuatro fechas son `timestamp` SIN zona y guardan siempre el reloj de pared en UTC, la
  // misma convención que `usuario` y `perfil`. Se evaluó y se MIDIÓ la variante con zona, que es
  // lo que corresponde conceptualmente a un instante absoluto, y no es utilizable con este
  // stack: Prisma sobre `@prisma/adapter-pg` serializa un `Date` como `2026-09-10 15:12:25.451`
  // (hora UTC sin marca de zona), así que PostgreSQL la interpreta con el `TimeZone` de la
  // sesión y guarda un instante corrido —tres horas con America/Santiago—, tanto por el API
  // tipado como por SQL crudo. El desfase se veía en la propia base: `invalidadoEn` quedaba tres
  // horas en el FUTURO respecto de `createdAt`.
  //
  // Con `timestamp` la convención es única en toda la tabla y no depende de ninguna zona. La
  // regla que la sostiene, y que hay que respetar en cualquier consulta futura: NUNCA comparar
  // estas columnas contra `now()` ni castearlas a la variante con zona; el instante siempre
  // viaja como parámetro casteado a `timestamp`, que es exactamente lo que escribe Prisma.
  expiraEn     DateTime  @db.Timestamp(3)
  // Dos timestamps y no un enum de estado: distinguen "lo usó su titular" de "lo mató un
  // cambio de contraseña por otra vía", y ambas son fechas útiles para el soporte.
  usadoEn      DateTime? @db.Timestamp(3)
  invalidadoEn DateTime? @db.Timestamp(3)
  createdAt    DateTime  @default(now()) @db.Timestamp(3)

  @@map("token_recuperacion")
}

// RF-14: subida y validación de archivos de reporte (Excel/CSV) por un NOTIFICADOR_RPC, contra
// uno de los formatos que el ADMIN le tiene asignados.

enum EstadoCargaArchivo {
  CON_ERRORES
  PENDIENTE_VISTO_BUENO
  APROBADA
  // Nuevo (rechazo de cargas aprobadas): una carga ya `APROBADA` que un ADMIN/REVISOR_REPOSITORIO
  // decidió desactivar unilateralmente. Irreversible, mismo criterio que el visto bueno: no hay
  // camino de vuelta a `APROBADA`. El detalle del rechazo (motivo, quién, cuándo) vive en
  // `CargaArchivoRechazo`, 1:1 con esta fila.
  RECHAZADA
}

enum TipoErrorCargaArchivo {
  COLUMNA_FALTANTE
  COLUMNA_INESPERADA
  VALOR_REQUERIDO_VACIO
  TIPO_DATO_INVALIDO
  REGLA_VALIDACION
  // Estructural: el archivo trae la fila de encabezados pero ninguna fila de datos debajo.
  SIN_FILAS_DATOS
}

// El binario se persiste igual que `FormatoExcel.contenidoPlantilla` (`Bytes`, sin cifrado
// adicional) — deuda técnica conocida, documentada en `docs/requerimientos.md`: es dato
// potencialmente clínico y el proyecto no tiene hoy un mecanismo de cifrado de aplicación.
model CargaArchivo {
  id                    String             @id @default(uuid())
  formatoExcelId        String
  formatoExcel          FormatoExcel       @relation(fields: [formatoExcelId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  usuarioId             String
  usuario               Usuario            @relation("CargasSubidasPorUsuario", fields: [usuarioId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  // RF-15: año/ventana de carga elegida por el notificador para esta subida. `Restrict` porque
  // este modelo no expone borrado de ventanas (tampoco hay borrado físico de nada en el sistema).
  ventanaCargaId        String
  ventanaCarga          VentanaCarga       @relation(fields: [ventanaCargaId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  nombreArchivoOriginal String
  tipoContenidoArchivo  String
  contenidoArchivo      Bytes
  cantidadFilasDatos    Int
  cantidadErrores       Int
  estado                EstadoCargaArchivo
  // Corrección RF-14/RF-20: el visto bueno ya NO lo da el notificador dueño de la carga (era una
  // autoaprobación). `vistoBuenoPorId` ahora identifica a quien realmente aprueba
  // (ADMIN/REVISOR_REPOSITORIO), nunca al notificador.
  vistoBuenoEn          DateTime?
  vistoBuenoPorId       String?
  vistoBuenoPor         Usuario?           @relation("CargasConVistoBuenoDe", fields: [vistoBuenoPorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  // El notificador ya no aprueba: solo "finaliza y envía" una `PENDIENTE_VISTO_BUENO` para que un
  // tercero (ADMIN/REVISOR_REPOSITORIO) la decida. No nulo = ya no admite una subida nueva para la
  // misma combinación (usuarioId, formatoExcelId, ventanaCargaId) hasta que se decida (aprobar o
  // rechazar). No cambia `estado`: solo marca que el paso del notificador ya se completó. Índice
  // único parcial (SQL a mano en la migración, Prisma no lo expresa): a lo más UNA
  // `PENDIENTE_VISTO_BUENO` con `finalizadaEn` no nulo por (usuarioId, ventanaCargaId).
  finalizadaEn          DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  errores ErrorCargaArchivo[]

  // Relaciones inversas de la publicación hacia el revisor y de las solicitudes de reemplazo,
  // exigidas por Prisma. NUNCA usarlas con `include` en listados: arrastrarían el detalle
  // completo (hasta 20.000 filas) de cada carga.
  publicacion                      CargaArchivoPublicada?    @relation("PublicacionDeCarga")
  publicacionesReemplazadasPorEsta CargaArchivoPublicada[]   @relation("PublicacionesReemplazadasPorCarga")
  solicitudesReemplazo             SolicitudReemplazoCarga[] @relation("SolicitudesDeCarga")
  solicitudesReemplazoOrigen       SolicitudReemplazoCarga[] @relation("CargaOrigenDeReemplazo")

  // Nuevo (rechazo de cargas aprobadas): 1:1, presente solo si esta carga fue rechazada.
  rechazo CargaArchivoRechazo? @relation("RechazoDeCarga")
  // Nuevo: presente solo si esta carga es la que CONSUMIÓ la reapertura de un rechazo anterior (el
  // notificador subió un archivo nuevo dentro del plazo habilitado por `CargaArchivoRechazo`).
  reaperturaGenerada CargaArchivoRechazo? @relation("ReaperturaConsumidaPorCarga")

  // Relación inversa de RF-31, exigida por Prisma. NUNCA usarla con `include` en listados.
  mensajes MensajeCarga[]

  // PostgreSQL no indexa las FK automáticamente. Sirve al EXISTS de historial del listado de
  // usuarios (RF-25) y a la verificación de la FK Restrict al eliminar una cuenta.
  @@index([usuarioId])
  @@map("carga_archivo")
}

// ============================================================
// Publicación de cargas aprobadas hacia el perfil revisor
// ============================================================

// Nuevo (rechazo de cargas aprobadas): distingue por qué se desactivó una `CargaArchivoPublicada`
// sin depender de inferirlo por la presencia/ausencia de `reemplazadaPorCargaArchivoId` (un
// rechazo nunca completa esa columna, un reemplazo consentido siempre la completa). Nullable:
// permanece `null` mientras `activo = true`.
enum TipoDesactivacionCargaPublicada {
  REEMPLAZO
  RECHAZO
}

// CABECERA: una fila por carga aprobada. Todo lo que aplica a la carga completa (visibilidad,
// reemplazo/rechazo) vive aquí, no en el detalle. 1:1 con `CargaArchivo`. Baja lógica vía `activo`,
// nunca borrado físico — mismo criterio que `Perfil.activo`/`FormatoExcel.activo`.
model CargaArchivoPublicada {
  id             String       @id @default(uuid())
  cargaArchivoId String       @unique
  cargaArchivo   CargaArchivo @relation("PublicacionDeCarga", fields: [cargaArchivoId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  publicadoEn    DateTime @default(now())
  publicadoPorId String
  publicadoPor   Usuario  @relation("PublicacionesCargaCreadasPor", fields: [publicadoPorId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  // Gobierna la VISIBILIDAD para el revisor, no la existencia: `false` cuando la carga que esta
  // cabecera representa fue reemplazada por una carga posterior ya aprobada, o rechazada
  // unilateralmente por un ADMIN/REVISOR_REPOSITORIO.
  activo Boolean @default(true)

  // Solo se completan cuando `activo` pasa a `false`. `desactivadaEn`/`motivoDesactivacion` sirven
  // para AMBOS motivos (reemplazo consentido o rechazo unilateral, ver `motivoDesactivacionTipo`);
  // `reemplazadaPorCargaArchivoId` sigue siendo específico de reemplazo consentido (queda `null` en
  // un rechazo, que no tiene todavía una carga de reemplazo en el momento de rechazar).
  desactivadaEn                DateTime?
  reemplazadaPorCargaArchivoId String?
  reemplazadaPorCargaArchivo   CargaArchivo?                     @relation("PublicacionesReemplazadasPorCarga", fields: [reemplazadaPorCargaArchivoId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  motivoDesactivacion          String?
  motivoDesactivacionTipo      TipoDesactivacionCargaPublicada?

  // DETALLE: una fila de esta relación por cada fila de datos del archivo original.
  filas CargaArchivoPublicadaFila[]

  @@map("carga_archivo_publicada")
}

// DETALLE: un registro POR CADA FILA de datos del archivo Excel/CSV ya aprobado. `valores` sigue
// siendo JSONB porque el conjunto de columnas es dinámico por `FormatoExcel` (definidas por el
// ADMIN, distintas entre formatos) — mismo motivo por el que el resto del motor de validación de
// RF-14 ya trabaja sobre `Record<nombreColumna, valor>` en vez de columnas SQL tipadas. Se crean
// todas de una vez con inserción masiva (`createMany`), nunca INSERT por fila.
model CargaArchivoPublicadaFila {
  id                      String                @id @default(uuid())
  cargaArchivoPublicadaId String
  cargaArchivoPublicada   CargaArchivoPublicada @relation(fields: [cargaArchivoPublicadaId], references: [id], onDelete: Cascade)

  // 1-based, mismo criterio ya usado en `ErrorCargaArchivo.numeroFila`/`ValidarYCargarArchivo`: la
  // fila de encabezado es la 1, así que la primera fila de datos es la 2.
  numeroFila Int
  // `Record<nombreColumna, valor>` de ESA fila. Fechas serializadas como ISO string (Json no admite
  // `Date`); mismo criterio de tipos que el resto del módulo tras serializar.
  valores    Json @db.JsonB

  // Constraint de integridad (no puede repetirse un número de fila bajo la misma cabecera), sirve
  // también como índice de consulta por `cargaArchivoPublicadaId` (prefijo izquierdo del compuesto)
  // — mismo patrón que `ColumnaFormatoExcel.@@unique([formatoExcelId, orden])`.
  @@unique([cargaArchivoPublicadaId, numeroFila])
  @@map("carga_archivo_publicada_fila")
}

// ============================================================
// Rechazo unilateral de una carga ya aprobada
// ============================================================

// A diferencia de `SolicitudReemplazoCarga` (el notificador pide, alguien más decide), aquí quien
// rechaza decide unilateralmente: no hay "solicitud pendiente" ni dos partes. 1:1 con
// `CargaArchivo`, irreversible (no hay endpoint para deshacer un rechazo). Habilita una REAPERTURA
// de la ventana para que el mismo notificador vuelva a subir un archivo para esa combinación
// (formato, ventana). RF-36: vigente hasta
// `max(ventana.fechaVencimiento, fin del día Chile de rechazadoEn + diasReapertura)` (ver
// `fechaVencimientoAutorizacion()` en `modules/ventanas-carga/domain/entities/VentanaCarga.ts`).
model CargaArchivoRechazo {
  id             String       @id @default(uuid())
  cargaArchivoId String       @unique
  cargaArchivo   CargaArchivo @relation("RechazoDeCarga", fields: [cargaArchivoId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  // Texto libre, obligatorio. NUNCA se registra en `logs/auditoria.txt` (solo metadata
  // estructurada), mismo criterio que `SolicitudReemplazoCarga.motivo`.
  motivo         String
  rechazadoEn    DateTime @default(now())
  rechazadoPorId String
  rechazadoPor   Usuario  @relation("RechazosDecididosPor", fields: [rechazadoPorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  // RF-36: copia de `VentanaCarga.diasVigenciaReemplazo` al momento del rechazo, para que editar la
  // ventana después no cambie un plazo ya otorgado. Las filas anteriores a RF-36 quedaron en 5 (el
  // valor fijo vigente cuando se rechazaron). CHECK 1..90 agregado a mano en la migración.
  diasReapertura Int

  // Se completan al FINALIZAR Y ENVIAR (no al subir) una carga de esa combinación (usuario,
  // ventana), con la ventana abierta o cerrada, en la MISMA transacción que fija su `finalizadaEn`:
  // la reapertura pendiente más reciente queda enlazada a esa carga (`...PorCargaArchivoId`, 1:1) y
  // las demás pendientes solo reciben `reaperturaConsumidaEn`. Un intento con errores, o uno que el
  // notificador no finalizó, no consume nada. Mismo patrón que
  // `SolicitudReemplazoCarga.utilizadaEn`/`nuevaCargaArchivoId`.
  reaperturaConsumidaEn                DateTime?
  reaperturaConsumidaPorCargaArchivoId String?       @unique
  reaperturaConsumidaPorCargaArchivo   CargaArchivo? @relation("ReaperturaConsumidaPorCarga", fields: [reaperturaConsumidaPorCargaArchivoId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  createdAt DateTime @default(now())

  @@map("carga_archivo_rechazo")
}

// ============================================================
// Solicitudes de reemplazo de una carga ya aprobada
// ============================================================

enum EstadoSolicitudReemplazoCarga {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Origen de la solicitud: `CARGA_APROBADA` es el camino original (reemplazar una carga ya
// aprobada); `CARGA_PENDIENTE_DECISION` es la ampliación que cubre una carga
// `PENDIENTE_VISTO_BUENO` ya finalizada por el notificador pero todavía sin decisión de un
// ADMIN/REVISOR_REPOSITORIO. Determina el efecto secundario al APROBAR (ver
// `PATCH /api/dashboard/solicitudes-reemplazo/[id]`): para `CARGA_PENDIENTE_DECISION` también
// rechaza la carga original para liberar la combinación (formato, ventana).
enum OrigenSolicitudReemplazoCarga {
  CARGA_APROBADA
  CARGA_PENDIENTE_DECISION
}

// Autoriza a un notificador a volver a subir un archivo para una combinación (formato, ventana) que
// ya tiene una carga APROBADA vigente, o que tiene una carga PENDIENTE_VISTO_BUENO ya finalizada y
// todavía sin decisión (ver `origen`). La autorización se CONSUME al finalizar y enviar el archivo
// de reemplazo (`utilizadaEn`/`nuevaCargaArchivoId`), no al subirlo: el notificador puede
// reintentar la subida mientras siga vigente. RF-36: EXPIRA en
// `max(ventana.fechaVencimiento, fin del día Chile de revisadoEn + diasVigencia)` si no se usa
// (calculado en lectura, nunca persistido como estado propio — mismo patrón que
// `TokenRecuperacion.expiraEn`/`VentanaCarga.estaAbierta`).
model SolicitudReemplazoCarga {
  id             String       @id @default(uuid())
  cargaArchivoId String
  cargaArchivo   CargaArchivo @relation("SolicitudesDeCarga", fields: [cargaArchivoId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  solicitadoPorId String
  solicitadoPor   Usuario @relation("SolicitudesReemplazoSolicitadasPor", fields: [solicitadoPorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  motivo          String

  origen OrigenSolicitudReemplazoCarga

  estado EstadoSolicitudReemplazoCarga @default(PENDIENTE)

  revisadoPorId      String?
  revisadoPor        Usuario?  @relation("SolicitudesReemplazoRevisadasPor", fields: [revisadoPorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  // Se fija junto con `estado`, nunca por separado. Es también el ancla de la expiración.
  revisadoEn         DateTime?
  comentarioRevision String?
  // RF-36: copia de `VentanaCarga.diasVigenciaReemplazo` al APROBAR (nula en PENDIENTE/RECHAZADA),
  // para que editar la ventana después no cambie un plazo ya otorgado. Las APROBADA anteriores a
  // RF-36 quedaron en 5. CHECKs a mano en la migración: obligatoria si `estado = APROBADA`, y 1..90.
  diasVigencia       Int?

  // Se completan al CONSUMIR la autorización: cuando el notificador FINALIZA Y ENVÍA la carga de
  // reemplazo, en la misma transacción que fija su `finalizadaEn`. `nuevaCargaArchivoId` apunta a
  // esa carga finalizada (nunca a un intento con errores ni a un borrador sin finalizar).
  nuevaCargaArchivoId String?
  nuevaCargaArchivo   CargaArchivo? @relation("CargaOrigenDeReemplazo", fields: [nuevaCargaArchivoId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  utilizadaEn         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("solicitud_reemplazo_carga")
}

// RF-15: ventana de tiempo (medida en año calendario) durante la cual un notificador puede subir
// un archivo. "Abierta" NO es una columna persistida: se calcula siempre comparando
// `fechaApertura`/`fechaVencimiento` contra un `ahora` que viaja como parámetro desde la
// aplicación, mismo criterio ya usado en `TokenRecuperacion` (RF-10) — nunca contra `now()` de
// PostgreSQL.
// `(anio, formatoExcelId)` NO lleva `@@unique` de columna completa en el schema: la unicidad solo
// debe regir mientras la ventana no esté eliminada (`eliminadaEn IS NULL`), para que se pueda
// volver a crear una ventana para el mismo año/formato cuya ventana anterior ya fue eliminada.
// Prisma no expresa un índice único parcial (`WHERE`) en su DSL, así que la restricción real vive
// como una sentencia SQL agregada a mano en la migración —mismo mecanismo ya usado en RF-09/RF-14
// para insertar datos fuera del DDL generado—, y `obtenerPorAnioYFormato()` filtra
// `eliminadaEn: null` en el `WHERE` de Prisma para que el código de aplicación vea exactamente la
// misma noción de "ese año y formato ya están tomados".
model VentanaCarga {
  id               String       @id @default(uuid())
  anio             Int
  // Timestamp sin zona, mismo criterio y mismo motivo documentado en `TokenRecuperacion.expiraEn`:
  // el reloj de pared siempre viaja en UTC "de pared", nunca comparado contra `now()` ni casteado
  // a la variante con zona.
  fechaApertura    DateTime     @db.Timestamp(3)
  fechaVencimiento DateTime     @db.Timestamp(3)
  // Formato de archivo concreto que esta ventana acepta (corrección posterior a RF-15 ampliación:
  // reemplaza el enum `tipoArchivo`, que solo distinguía EXCEL/CSV sin llegar a un formato real).
  // Relación 1:1 desde `VentanaCarga` hacia `FormatoExcel` (una ventana referencia exactamente un
  // formato; varias ventanas de años distintos pueden apuntar al mismo formato). `Restrict`, mismo
  // criterio que `CargaArchivo.formatoExcelId`: protege contra el borrado físico de un formato con
  // ventanas asociadas (hoy no hay borrado físico de formatos, la protección queda como defensa en
  // profundidad). Editable después de creada (mismo endpoint PUT que las fechas): una
  // `CargaArchivo` ya subida conserva su propio `formatoExcelId`, no derivado de la ventana.
  formatoExcelId   String
  formatoExcel     FormatoExcel @relation(fields: [formatoExcelId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  // Nace en `false` (borrador) y se activa/desactiva con el endpoint PATCH dedicado, nunca con el
  // PUT de fechas/formato: mientras no esté publicada, el notificador no debe verla (exclusión real
  // en el `WHERE` de `listarDisponibles`, no solo en la UI).
  publicada        Boolean      @default(false)
  // Oculta la ventana de la vista por defecto del panel administrativo (recuperable por búsqueda,
  // ver "Mostrar archivadas" en la UI), sin relación con `eliminadaEn` (irreversible, atado al
  // `RESTRICT` de `CargaArchivo`) ni con `publicada` (es el efecto, no la causa: archivar apaga
  // `publicada` en la misma escritura; desarchivar NO la vuelve a publicar automáticamente).
  archivada        Boolean      @default(false)
  creadoPorId      String
  creadoPor        Usuario      @relation("VentanasCargaCreadasPor", fields: [creadoPorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  // Eliminación: ADMIN puede eliminar cualquier ventana, REVISOR_REPOSITORIO solo las que él mismo
  // creó (enforced en `application/`, no aquí). Física si no tiene cargas asociadas (el propio
  // `ON DELETE RESTRICT` de `CargaArchivo.ventanaCargaId` lo impide y el repositorio traduce ese
  // rechazo a una eliminación lógica); lógica (estos dos campos) si ya tiene cargas, para no
  // perder a qué ventana perteneció una carga ya aprobada. `eliminadaEn` no nulo también apaga
  // `estaAbierta()` sin importar las fechas: una ventana eliminada nunca vuelve a habilitar subidas.
  eliminadaEn      DateTime?    @db.Timestamp(3)
  eliminadaPorId   String?
  eliminadaPor     Usuario?     @relation("VentanasCargaEliminadasPor", fields: [eliminadaPorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Alertas por email a notificadores que no han reportado (RF-17). Ambos nulos a la vez o
  // ninguno: `application/ConfigurarAlertasVentanaCargaSchema` exige que vengan juntos o ninguno.
  // `null` desactiva el envío automático de esta ventana, sin afectar el envío manual.
  diasAnticipacionInicio  Int?
  intervaloRepeticionDias Int?
  // HTML sanitizado (ver `sanitizarPlantillaAlertaHtml`). NUNCA nulo: nace como copia de
  // `PLANTILLA_ALERTA_POR_DEFECTO_HTML` al crearse la ventana (no es un campo del formulario de
  // creación), editable después con su propio endpoint PUT.
  plantillaAlerta         String
  // RF-36: días que dura la habilitación fuera de plazo que se otorga al aprobar una solicitud de
  // reemplazo o al rechazar una carga (reapertura). Se COPIA en la solicitud/rechazo al decidir.
  // CHECK 1..90 agregado a mano en la migración.
  diasVigenciaReemplazo   Int     @default(7)

  cargas              CargaArchivo[]
  alertasNotificacion AlertaNotificacionVentana[]
  // Relación inversa de RF-31, exigida por Prisma. NUNCA usarla con `include` en listados.
  mensajesCarga       MensajeCarga[]

  @@map("ventana_carga")
}

// ============================================================
// RF-31: mensajería entre REVISOR_REPOSITORIO y NOTIFICADOR_RPC sobre cargas
// ============================================================

// Lado de la conversación que escribió el mensaje. Se persiste al escribir y no se deriva del
// perfil actual del autor, que puede cambiar con el tiempo.
enum LadoMensajeCarga {
  REVISOR
  NOTIFICADOR
}

// Un hilo continuo por notificador (`notificadorId`); cada mensaje queda etiquetado con la carga
// sobre la que se escribió y, por ella, con su ventana. La bandeja del lado revisor es COMPARTIDA
// entre todos los REVISOR_REPOSITORIO: `autorId` identifica a la persona concreta que escribió.
//
// `ventanaCargaId` y `notificadorId` son COPIAS denormalizadas de `carga_archivo.ventanaCargaId` y
// `carga_archivo.usuarioId` (nunca cambian en una carga): permiten contar no leídos por ventana con
// `groupBy` sin JOIN. El repositorio las copia SIEMPRE desde la fila de la carga, nunca desde el
// cliente. Coherencia de lado reforzada con un CHECK agregado a mano en la migración: un mensaje
// del lado NOTIFICADOR solo puede tener como autor al propio notificador del hilo.
model MensajeCarga {
  id             String           @id @default(uuid())
  cargaArchivoId String
  cargaArchivo   CargaArchivo     @relation(fields: [cargaArchivoId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  ventanaCargaId String
  ventanaCarga   VentanaCarga     @relation(fields: [ventanaCargaId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  notificadorId  String
  notificador    Usuario          @relation("MensajesCargaDeNotificador", fields: [notificadorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  autorId        String
  autor          Usuario          @relation("MensajesCargaEscritosPor", fields: [autorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  ladoAutor      LadoMensajeCarga
  // Texto plano. Nunca se registra en logs ni viaja en correos.
  contenido      String           @db.VarChar(1000)
  // Timestamps sin zona, mismo convenio que `TokenRecuperacion`: el instante siempre viaja como
  // parámetro desde la aplicación, nunca comparado contra `now()` de PostgreSQL.
  creadoEn       DateTime         @default(now()) @db.Timestamp(3)
  // Lectura por el lado CONTRARIO al autor; NULL = sin leer. Del lado revisor basta un solo valor
  // porque la bandeja es compartida: lo que lee un revisor queda leído para todos.
  leidoEn        DateTime?        @db.Timestamp(3)

  // Hilo de un notificador en una ventana, ordenado; su prefijo `notificadorId` cubre también el
  // resumen por ventana del inicio del notificador y el EXISTS de historial de RF-25.
  @@index([notificadorId, ventanaCargaId, creadoEn])
  // Conteos de no leídos por ventana (inicio del revisor) y columna izquierda del modal.
  @@index([ventanaCargaId, ladoAutor, leidoEn])
  // EXISTS de historial de RF-25 y verificación de la FK Restrict al eliminar una cuenta.
  @@index([autorId])
  @@map("mensaje_carga")
}

// RF-17: alertas por email a notificadores (NOTIFICADOR_RPC) que no han reportado su archivo en
// una ventana de carga.
enum TipoAlertaNotificacion {
  AUTOMATICA
  MANUAL_MASIVA
  MANUAL_INDIVIDUAL
}

enum ResultadoAlertaNotificacion {
  EXITO
  ERROR
}

// Historial de envíos, agrupado por lote (`loteId`): todas las filas de una misma operación (un
// ciclo automático de UNA ventana, un clic de "enviar masivo", un clic de "enviar individual" —
// lote de tamaño 1) comparten el mismo `loteId`. Generado en `application/`, nunca en este
// repositorio.
model AlertaNotificacionVentana {
  id              String                      @id @default(uuid())
  loteId          String
  ventanaCargaId  String
  ventanaCarga    VentanaCarga                @relation(fields: [ventanaCargaId], references: [id], onDelete: Restrict)
  usuarioId       String
  usuario         Usuario                     @relation("AlertasNotificacionRecibidasPor", fields: [usuarioId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  tipo            TipoAlertaNotificacion
  resultado       ResultadoAlertaNotificacion
  asunto          String
  // HTML final REALMENTE enviado (placeholders ya resueltos, enlace ya resuelto a la URL real,
  // sanitizado dos veces: `sanitizarPlantillaAlertaHtml` al guardar la plantilla/mensaje editado,
  // `sanitizarMensajeResueltoHtml` al enviar). No es la plantilla genérica de la ventana.
  mensaje         String
  // Solo si `resultado = ERROR`, del ÚLTIMO intento. Saneado con el mismo criterio que
  // `describirFalloEnvio` de RF-10: nunca contiene una dirección de correo.
  detalleError    String?
  disparadoPorId  String?
  disparadoPor    Usuario?                    @relation("AlertasNotificacionDisparadasPor", fields: [disparadoPorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  // Solo para `tipo = AUTOMATICA`: día calendario en UTC "de pared" (mismo criterio que el resto
  // del esquema). Clave de deduplicación junto a `ventanaCargaId`/`usuarioId` (ver índice único
  // parcial agregado a mano en la migración).
  fechaProgramada DateTime?                   @db.Timestamp(3)
  createdAt       DateTime                    @default(now())

  // Mismo motivo que `CargaArchivo.@@index([usuarioId])` (RF-25): tabla que crece con cada envío.
  @@index([usuarioId])
  @@map("alerta_notificacion_ventana")
}

// Tope de 500 filas por carga, aplicado en `application/`: evita miles de INSERTs con un
// archivo mal formado. Si se excede, se corta ahí y se agrega una fila resumen con
// `numeroFila = 0` y `columna = null`.
model ErrorCargaArchivo {
  id             String                @id @default(uuid())
  cargaArchivoId String
  cargaArchivo   CargaArchivo          @relation(fields: [cargaArchivoId], references: [id], onDelete: Cascade)
  numeroFila     Int
  columna        String?
  tipoError      TipoErrorCargaArchivo
  mensaje        String

  @@map("error_carga_archivo")
}

// ============================================================
// RF-37: perfil Bioestadística (archivos de Defunciones y Egresos por año, formato libre)
// ============================================================

// Lista fija por decisión de producto: agregar un tercer tipo exige UI y reglas propias.
enum TipoArchivoBioestadistica {
  DEFUNCIONES
  EGRESOS
}

// Ciclo de vida de una carga de Bioestadística. `PROCESANDO`: recibida y en procesamiento
// asíncrono (sus filas todavía NO son datos vigentes). `ACTIVA`: vigente para su (usuario, año,
// tipo). `REEMPLAZADA`: desactivada por una carga posterior autorizada (equivale al `activo=false`
// del notificador; conserva filas y archivo). `FALLIDA`: el procesamiento no terminó (filas y
// archivo ya limpiados; el código va en `motivoFallo`).
enum EstadoCargaBioestadistica {
  PROCESANDO
  ACTIVA
  REEMPLAZADA
  FALLIDA
}

// CABECERA de un archivo de Bioestadística. Depende del AÑO, no de una ventana concreta: `anio` va
// sin FK a `ventana_carga` a propósito (con varias ventanas por año, una FK no aporta nada estable,
// y una `Restrict` cambiaría la eliminación física de ventanas que hoy decide el `RESTRICT` de
// `carga_archivo`). El binario vive EN DISCO (`rutaArchivo`, relativa al directorio base
// `DIRECTORIO_ARCHIVOS_BIOESTADISTICA`), nunca en `Bytes`: un archivo puede pesar hasta 200 MB.
// SQL a mano en la migración: índices únicos parciales (una ACTIVA y un PROCESANDO por usuario,
// año y tipo) y CHECKs de coherencia de estado.
model CargaBioestadistica {
  id                    String                    @id @default(uuid())
  anio                  Int
  tipoArchivo           TipoArchivoBioestadistica
  usuarioId             String
  usuario               Usuario                   @relation("CargasBioestadisticaSubidasPor", fields: [usuarioId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  // COPIA del establecimiento de la persona al momento de subir: la vista administrativa muestra
  // dónde se reportó aunque la persona cambie después de establecimiento.
  establecimientoId     String
  establecimiento       Establecimiento           @relation(fields: [establecimientoId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  // Solo se muestra; nunca forma parte de la ruta en disco.
  nombreArchivoOriginal String                    @db.VarChar(255)
  // Decidido por la firma de bytes, nunca por lo que declara el cliente.
  tipoContenidoArchivo  String
  // Relativa al directorio base (`<anio>/<id>.<xlsx|csv>`), generada por el servidor. `NULL` tras
  // limpiar una `FALLIDA`.
  rutaArchivo           String?
  tamanoBytes           BigInt
  // SHA-256 hexadecimal calculado mientras se recibe el archivo (integridad y trazabilidad).
  sha256                String                    @db.Char(64)
  // Orden original de las columnas: JSONB no conserva el orden de las claves de `valores`.
  encabezados           String[]
  cantidadFilasDatos    Int                       @default(0)
  estado                EstadoCargaBioestadistica @default(PROCESANDO)
  // Código, nunca contenido: ENCABEZADOS_INVALIDOS, SIN_FILAS_DATOS, TOPE_FILAS, ARCHIVO_ILEGIBLE,
  // REEMPLAZO_NO_AUTORIZADO, YA_REPORTADO, PROCESAMIENTO_INTERRUMPIDO. No nulo si y solo si
  // `estado = FALLIDA` (CHECK).
  motivoFallo           String?                   @db.VarChar(40)
  procesadaEn           DateTime?                 @db.Timestamp(3)
  // No nulo si y solo si `estado = REEMPLAZADA` (CHECK).
  desactivadaEn         DateTime?                 @db.Timestamp(3)
  reemplazadaPorCargaId String?                   @unique
  reemplazadaPorCarga   CargaBioestadistica?      @relation("ReemplazoCargaBioestadistica", fields: [reemplazadaPorCargaId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  // Texto libre del motivo de la solicitud que autorizó el reemplazo. Nunca se registra en logs.
  motivoDesactivacion   String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  // Relación inversa de la auto-FK de reemplazo, exigida por Prisma.
  reemplazaA CargaBioestadistica? @relation("ReemplazoCargaBioestadistica")

  // DETALLE: NUNCA usarla con `include` en listados (hasta 2 millones de filas por carga).
  filas CargaBioestadisticaFila[]

  // Relaciones inversas de las solicitudes de reemplazo, exigidas por Prisma. NUNCA con `include`.
  solicitudesReemplazo SolicitudReemplazoBioestadistica[] @relation("SolicitudesDeCargaBioestadistica")
  solicitudesConsumidas SolicitudReemplazoBioestadistica[] @relation("CargaBioestadisticaOrigenDeReemplazo")

  // EXISTS de historial de RF-25 y verificación de la FK Restrict al eliminar una cuenta.
  @@index([usuarioId])
  // Listado administrativo por año y tipo.
  @@index([anio, tipoArchivo, estado])
  @@index([establecimientoId])
  @@map("carga_bioestadistica")
}

// DETALLE: una fila por cada fila de datos del archivo. `valores` es JSONB porque las columnas son
// libres (cada archivo trae las suyas). Los consumidores SIEMPRE deben hacer JOIN con la cabecera y
// filtrar `estado = 'ACTIVA'`: las filas de una `PROCESANDO` o `REEMPLAZADA` no son datos vigentes.
// Se insertan por lotes con `createMany`, nunca una por una.
model CargaBioestadisticaFila {
  id                    String              @id @default(uuid())
  cargaBioestadisticaId String
  cargaBioestadistica   CargaBioestadistica @relation(fields: [cargaBioestadisticaId], references: [id], onDelete: Cascade)
  // Número real de la fila en el archivo (la fila 1 es la de encabezados). Las filas completamente
  // vacías se omiten conservando la numeración real.
  numeroFila            Int
  // `Record<encabezado, valor>`; fechas como ISO string.
  valores               Json                @db.JsonB

  @@unique([cargaBioestadisticaId, numeroFila])
  @@map("carga_bioestadistica_fila")
}

// Autoriza a una persona de Bioestadística a reemplazar su archivo ACTIVO de un (año, tipo). Mismo
// ciclo que `SolicitudReemplazoCarga`: PENDIENTE → APROBADA/RECHAZADA por ADMIN o
// REVISOR_REPOSITORIO; al aprobar se COPIA `diasVigencia` (máximo `diasVigenciaReemplazo` de las
// ventanas del año publicadas y no archivadas, o 7). Se CONSUME al activarse el archivo de reemplazo
// (`utilizadaEn`/`nuevaCargaBioestadisticaId`). Vigencia calculada en lectura con
// `fechaVencimientoAutorizacion` (RF-36). SQL a mano: único parcial `WHERE estado = 'PENDIENTE'`
// sobre la carga y los CHECK de `diasVigencia`.
model SolicitudReemplazoBioestadistica {
  id                    String              @id @default(uuid())
  cargaBioestadisticaId String
  cargaBioestadistica   CargaBioestadistica @relation("SolicitudesDeCargaBioestadistica", fields: [cargaBioestadisticaId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  solicitadoPorId String
  solicitadoPor   Usuario @relation("SolicitudesReemplazoBioestadisticaSolicitadasPor", fields: [solicitadoPorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  // Texto libre. Nunca se registra en logs ni en auditoría.
  motivo          String

  estado EstadoSolicitudReemplazoCarga @default(PENDIENTE)

  revisadoPorId      String?
  revisadoPor        Usuario?  @relation("SolicitudesReemplazoBioestadisticaRevisadasPor", fields: [revisadoPorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  revisadoEn         DateTime?
  comentarioRevision String?
  // Copia de los días de vigencia al APROBAR (nula en PENDIENTE/RECHAZADA). CHECKs a mano.
  diasVigencia       Int?

  nuevaCargaBioestadisticaId String?
  nuevaCargaBioestadistica   CargaBioestadistica? @relation("CargaBioestadisticaOrigenDeReemplazo", fields: [nuevaCargaBioestadisticaId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  utilizadaEn                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // EXISTS de historial de RF-25 (ambas FK hacia `usuario`) y "Mis solicitudes".
  @@index([solicitadoPorId])
  @@index([revisadoPorId])
  @@index([cargaBioestadisticaId])
  // FK Restrict hacia `carga_bioestadistica`: sin índice, borrar o actualizar el id de una carga
  // obligaría a recorrer la tabla completa para verificar la FK.
  @@index([nuevaCargaBioestadisticaId])
  @@map("solicitud_reemplazo_bioestadistica")
}

// Errores técnicos persistentes. A diferencia de los archivos locales de Winston, esta tabla
// sobrevive reinicios y cambios de instancia en producción.
model RegistroErrorSistema {
  id        String   @id @default(uuid())
  mensaje   String
  campos    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("registro_error_sistema")
}
