# Copia este archivo como `.env` y completa los valores. `.env` NO se versiona.
# `src/infrastructure/config/env.ts` valida estas variables con Zod al importarse: si algo
# falta o está mal formado, la aplicación falla en el arranque y no en medio de una petición.

# --- Obligatorias ---

# Cadena de conexión PostgreSQL.
DATABASE_URL="postgres://usuario:contrasena@localhost:5432/repositorio_rem"

# Secreto para firmar los JWT de sesión (jose, HS256). Mínimo 32 caracteres.
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# --- Solo para `npm run db:seed` (no pasa por env.ts) ---

# Contraseña del usuario administrador inicial que siembra `scripts/seed-admin.ts`.
ADMIN_SEED_PASSWORD="cambia-esto-antes-de-sembrar"

# --- Correo saliente (RF-10, recuperación de contraseña) ---
#
# Todo este grupo es OPCIONAL: sin él la aplicación arranca y opera normalmente, solo queda
# desactivado el autoservicio de recuperación (el administrador sigue pudiendo restablecer
# contraseñas desde el mantenedor). La validación es de todo o nada: definir SMTP_HOST obliga
# a definir también SMTP_FROM y APP_URL, y SMTP_USER y SMTP_PASSWORD van juntas o ninguna.

# URL pública de la aplicación, sin barra final. El enlace del correo se construye SIEMPRE a
# partir de este valor y jamás desde la cabecera Host de la petición.
# APP_URL="https://intranet.ejemplo.cl"

# Host del relay SMTP institucional. Definirlo activa el grupo completo.
# SMTP_HOST="smtp.ejemplo.cl"

# Puerto del relay. 587 con STARTTLS, 465 con TLS implícito, 25 en un relay interno.
# SMTP_PORT="587"

# TLS implícito desde el saludo. Por defecto se activa solo cuando SMTP_PORT es 465.
# SMTP_SECURE="false"

# Credenciales de la casilla remitente. Se omiten si el relay autoriza por IP de origen.
# SMTP_USER="no-responder@ejemplo.cl"
# SMTP_PASSWORD="completar-en-el-.env-local"

# Remitente de los correos. Admite el formato `Nombre <casilla@dominio.cl>`.
# SMTP_FROM="Intranet SEREMI <no-responder@ejemplo.cl>"

# Último recurso para un relay interno con certificado propio. Nunca usarlo contra un relay
# expuesto a internet: desactiva la verificación del certificado TLS.
# SMTP_REJECT_UNAUTHORIZED="true"

# Solo true detrás de un proxy verificado que agrega la IP real al final de XFF.
# El puerto de Next debe quedar inaccesible desde internet. Sin esto, cupo compartido.
TRUST_PROXY="false"
